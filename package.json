{
  "name": "dealerflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "seed": "node apps/api/seed.js",
    "seed:showcase": "node apps/api/showcase.js",
    "assets:vehicles": "node scripts/generate-vehicle-art.js",
    "type-check": "tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "test": "node scripts/test-postgres.js",
    "test:api": "node scripts/test-postgres.js api",
    "test:web": "node scripts/test-postgres.js web",
    "db:migrate:sqlite": "node apps/api/migrate-sqlite.js",
    "build": "npm run build --workspace apps/web",
    "format": "prettier --write . --ignore-path .gitignore"
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "express": "latest",
    "helmet": "latest",
    "multer": "latest",
    "pg": "8.23.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "embedded-postgres": "18.7.0-beta.19",
    "eslint": "latest",
    "globals": "latest",
    "prettier": "latest",
    "sharp": "^0.35.5",
    "typescript-eslint": "latest"
  }
}
