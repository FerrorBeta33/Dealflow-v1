# PostgreSQL is required. Preview manages its own private local connection.
# For a managed PostgreSQL server, configure DATABASE_URL or all PG* variables.
# Connections use ssl: false; use the platform's private database network.
# DATABASE_URL=
# PGHOST=
# PGPORT=5432
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
# Optional separate, empty PostgreSQL target for npm run seed:showcase.
# SHOWCASE_DATABASE_URL=
# Local uploads/backups and generated private demo access stay here.
# DATA_DIR=.data
# Optional one-time seed password; migrated accounts are never reset.
# DEMO_PASSWORD=
# API_PORT=4174
# Offline import: npm run db:migrate:sqlite -- --offline path/to/source.sqlite
