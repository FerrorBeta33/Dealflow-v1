{
  "version": 2,
  "start": "PATH=\"$PWD/.data/runtime/bin:$PATH\" npm run dev",
  "port": 4173,
  "install": [
    {
      "name": "Node.js runtime",
      "check": "PATH=\"$PWD/.data/runtime/bin:$PATH\" node -e \"const [a,b]=process.versions.node.split('.').map(Number); process.exit(a>22 || a===22&&b>=12 ? 0 : 1)\"",
      "run": "sh scripts/ensure-runtime.sh"
    },
    {
      "name": "npm dependencies",
      "check": "test -d node_modules && test -f node_modules/.package-lock.json && test package-lock.json -ot node_modules/.package-lock.json",
      "run": "PATH=\"$PWD/.data/runtime/bin:$PATH\" npm ci"
    },
    {
      "name": "SQLite and fictional fixtures",
      "check": "test -f .data/dealerflow.sqlite",
      "run": "PATH=\"$PWD/.data/runtime/bin:$PATH\" npm run seed"
    }
  ],
  "services": []
}
